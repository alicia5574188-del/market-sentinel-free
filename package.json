{
  "name": "market-sentinel-free",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=22.15.0"
  },
  "scripts": {
    "install:ci": "bash scripts/install-ci.sh",
    "test:all-regime": "node --experimental-strip-types --test tests/all-regime-engine.test.ts",
    "research:all-regime": "node --experimental-strip-types scripts/research-all-regime.mjs",
    "research:phase-specialists": "node --experimental-strip-types scripts/research-phase-specialists.mjs",
    "research:phase-portfolio-report": "node scripts/build-phase-portfolio-report.mjs",
    "research:aggregate-gate": "node scripts/aggregate-gate-history.mjs",
    "research:v6-long-horizon": "node scripts/research-v6-long-horizon.mjs",
    "research:n-engine-report": "node scripts/build-n-engine-portfolio-report.mjs",
    "research:regime-systems": "node scripts/research-regime-system-portfolios.mjs",
    "research:v11": "node scripts/research-v11.mjs",
    "research:v12": "node --experimental-strip-types scripts/research-v12.mjs",
    "test:direct": "node --experimental-strip-types --test tests/*.test.ts",
    "dev": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vite",
    "build": "bash scripts/build-verified.sh",
    "start": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start",
    "test:live-parity": "node --experimental-strip-types --test tests/live-parity.test.ts tests/live-coverage-turnover.test.ts tests/live-risk-correctness.test.ts",
    "test:members": "node --experimental-strip-types --test tests/members.test.ts",
    "test:members:workerd": "node tests/member-workerd-smoke.mjs",
    "test:equity": "node --experimental-strip-types --test tests/equity-curve.test.ts tests/equity-cache.test.ts",
    "test": "npm run test:equity && npm run test:members && npm run test:live-parity && npm run build && node --test tests/architecture.test.mjs tests/migration.test.mjs",
    "test:forward": "node --experimental-strip-types --test tests/forward-*.test.ts",
    "test:signals": "npm run test:direct",
    "lint": "bash scripts/sites-env.sh -- eslint . --ignore-pattern dist --ignore-pattern .next",
    "typecheck": "tsc --noEmit --incremental false",
    "test:module:exit": "node --experimental-strip-types --test tests/multi-turn-exit.test.ts tests/multi-turn-exit-controller.test.ts tests/multi-turn-hold-value.test.ts",
    "test:module:clock": "node --experimental-strip-types --test tests/multi-turn-clock.test.ts tests/multi-turn-execution.test.ts",
    "test:module:entry": "node --experimental-strip-types --test tests/region-lifecycle.test.ts tests/region-entry-policy.test.ts tests/multi-turn-entry-opportunity.test.ts tests/multi-turn-entry-policy.test.ts tests/multi-turn-entry-memory.test.ts tests/multi-turn-engine.test.ts tests/multi-turn-execution.test.ts"
  },
  "dependencies": {
    "drizzle-orm": "0.45.2",
    "next": "16.2.6",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@cloudflare/workers-types": "^4.20260702.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "react-server-dom-webpack": "19.2.8",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module",
  "displayName": "Forward Market Relation Engine"
}
