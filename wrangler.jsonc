{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "market-sentinel-free",
  "main": "./dist/server/index.js",
  "no_bundle": true,
  "compatibility_date": "2026-08-24",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "market-sentinel-free",
      "migrations_dir": "./drizzle",
      "database_id": "9863619f-afc7-4dfa-8798-b4445e41c013"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "POSITION_MONITOR",
        "class_name": "PositionMonitor"
      },
      {
        "name": "MARKET_SCANNER",
        "class_name": "MarketScanner"
      },
      {
        "name": "LIVE_TRADING_COORDINATOR",
        "class_name": "LiveTradingCoordinator"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["PositionMonitor", "MarketScanner"]
    },
    {
      "tag": "v2",
      "new_sqlite_classes": ["LiveTradingCoordinator"]
    }
  ],
  "version_metadata": {
    "binding": "CF_VERSION_METADATA"
  },
  "triggers": {
    "crons": ["* * * * *"]
  },
  "vars": {
    "BACKGROUND_MODE": "cloudflare-free",
    "SITE_OWNER_EMAIL": "alicia5574188@gmail.com",
    "VAPID_SUBJECT": "mailto:alicia5574188@gmail.com"
  },
  "observability": {
    "enabled": true
  }
}
