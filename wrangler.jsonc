{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "market-sentinel-free",
  "main": "./dist/server/index.js",
  "no_bundle": true,
  "compatibility_date": "2026-08-24",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "market-sentinel-free",
      "migrations_dir": "./drizzle",
      "database_id": "9863619f-afc7-4dfa-8798-b4445e41c013"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "MARKET_STREAM",
        "class_name": "MarketStream"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "PositionMonitor",
        "MarketScanner"
      ]
    },
    {
      "tag": "v2",
      "new_sqlite_classes": [
        "LiveTradingCoordinator"
      ]
    },
    {
      "tag": "v3",
      "new_sqlite_classes": [
        "MarketScannerV2"
      ]
    },
    {
      "tag": "v4",
      "new_sqlite_classes": [
        "HTE31MarketScanner",
        "HTE31TradeManager"
      ]
    },
    {
      "tag": "v5-historical-archive",
      "new_sqlite_classes": [
        "HistoricalArchive"
      ]
    },
    {
      "tag": "v6-liquidity-three-state",
      "new_sqlite_classes": ["MarketStream"]
    },
    {
      "tag": "v7-delete-legacy-do",
      "deleted_classes": [
        "PositionMonitor",
        "MarketScanner",
        "LiveTradingCoordinator",
        "MarketScannerV2",
        "HTE31MarketScanner",
        "HTE31TradeManager",
        "HistoricalArchive"
      ]
    }
  ],
  "version_metadata": {
    "binding": "CF_VERSION_METADATA"
  },
  "triggers": {
    "crons": ["* * * * *"]
  },
  "observability": {
    "enabled": true
  }
}
